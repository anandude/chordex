# Copy to .env on the InstaBox machine (never commit .env).

# The deployed frontend's URL(s), comma-separated, no trailing slash.
ALLOWED_ORIGINS=https://chordex.vercel.app

# YouTube links from this box: YouTube challenges datacenter IPs with
# "Sign in to confirm you're not a bot". youtube.py retries the download on each
# player client below; set YOUTUBE_COOKIES_FILE (and mount it) or YOUTUBE_PROXY
# if every client is refused. File uploads are unaffected either way.
YOUTUBE_PLAYER_CLIENTS=android_vr,ios,tv,mweb,web_safari
# YOUTUBE_COOKIES_FILE=/run/secrets/youtube-cookies.txt
# YOUTUBE_PROXY=http://user:pass@host:port

# Hugging Face token for the gated Malayalam model
# (bodhan-ai/indic-transcribe-core). Vault env items only reach login
# shells, not containers, so to keep it out of your local files write this
# whole file from the Vault instead:
#   instabox vault set-file chordex/deploy/instabox/.env --from ./prod.env
# Without it, Malayalam falls back to an older model.
HF_TOKEN=

# Song history ("your songs" on /upload). A Neon Postgres database; the table is
# created on boot. Use the POOLED connection string (Neon's "-pooler" host,
# PgBouncer transaction mode) — library.py already disables prepared statements
# for it. Leave it unset and the library is simply off: no history, no errors,
# and nothing else changes. Neon's free tier is plenty for this.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
