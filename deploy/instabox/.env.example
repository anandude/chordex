# Copy to .env on the InstaBox machine (never commit .env).

# The deployed frontend's URL(s), comma-separated, no trailing slash.
ALLOWED_ORIGINS=https://chordex.vercel.app

# Hugging Face token for the gated Malayalam model
# (bodhan-ai/indic-transcribe-core). Vault env items only reach login
# shells, not containers, so to keep it out of your local files write this
# whole file from the Vault instead:
#   instabox vault set-file chordex/deploy/instabox/.env --from ./prod.env
# Without it, Malayalam falls back to an older model.
HF_TOKEN=
