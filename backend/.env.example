# Backend environment variables
# Copy this to .env and fill in your values for local development.

# Redis connection string (rediss://... for Upstash TLS)
REDIS_URL=redis://localhost:6379

# Shared upload directory (API + worker must see the same path)
UPLOAD_DIR=/tmp/chordex_uploads

# Chord engine: auto | chordino | template
CHORD_ENGINE=auto

# Lyrics pipeline (Phases 1–5). Every stage is flagged and falls back gracefully.
# WHISPER_MODEL is the default for auto/en. Hindi/Malayalam use Indic
# fine-tunes (adalat-ai medium, Apache-2.0) unless overridden; if an HF model
# fails to load, the pipeline falls back to large-v3-turbo automatically.
ENABLE_LYRICS=1
WHISPER_MODEL=small
# WHISPER_LANGUAGE=en            # hard override when upload has no language hint
# WHISPER_MODEL_OVERRIDES={"hi":"adalat-ai/whisper-small-hi-high-lr","ml":"large-v3-turbo"}
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# HF_TOKEN=                    # required for gated models (indic-conformer)

# Phase 1 — vocal separation: none | demucs | roformer (default demucs).
# Demucs model: htdemucs_ft (first run downloads weights). Roformer checkpoint
# resolves from audio-separator's installed model list when left empty.
LYRICS_SEPARATION_BACKEND=demucs
# LYRICS_DEMUCS_MODEL=htdemucs_ft
# LYRICS_ROFORMER_MODEL=mel_band_roformer_vocals_becruily.ckpt
# LYRICS_DEREVERB=0            # experimental dereverb sub-stage (default off)
# LYRICS_DEREVERB_MODEL=
# LYRICS_SEPARATION_TIMEOUT_S=600

# Phase 2 — LRCLIB verified-lyrics lookup (free, no key). Disable to force ASR.
LYRICS_LRCLIB=1
# LYRICS_LRCLIB_TIMEOUT_S=10

# Phase 3 — music-tuned chunking (seconds). Indic scripts are token-dense:
# 10–15 s windows avoid the 448-token truncation of 30 s windows.
# LYRICS_ASR_CHUNK_S=12
# LYRICS_ASR_OVERLAP_S=2

# Phase 4 — CTC forced alignment (MMS weights are CC-BY-NC — see LICENSE-NOTES.md).
LYRICS_ALIGNMENT=1
# LYRICS_ALIGNMENT_MODEL=MahmoudAshraf/mms-300m-1130-forced-aligner

# Phase 5a — LLM cleanup (no provider wired; off by default, ASR text only).
LYRICS_LLM_CLEANUP=0

# Phase 5b — romanisation display backend: indic (default, always works) | xlit
# (blocked on fairseq/py3.11 — see pipeline/cleanup.py).
# LYRICS_ROMAN_BACKEND=indic

# Shared on-disk cache for every lyrics stage (content-hash keyed).
# LYRICS_CACHE_DIR=/tmp/chordex_lyrics_cache

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# Maximum upload size in megabytes
MAX_FILE_SIZE_MB=20

# Optional S3/R2 storage (leave empty for local filesystem)
# S3_BUCKET=
# S3_PREFIX=uploads
# S3_ENDPOINT_URL=
# AWS_REGION=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
