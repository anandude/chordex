# Backend environment variables
# Copy this to .env and fill in your values for local development.

# Redis connection string (rediss://... for Upstash TLS)
REDIS_URL=redis://localhost:6379

# Shared upload directory (API + worker must see the same path)
UPLOAD_DIR=/tmp/chordex_uploads

# Chord engine: auto | chordino | template
CHORD_ENGINE=auto

# S1 — chord metadata fast path. CHORD_META=0 skips the second full audio
# decode plus key/tempo/beat analysis in the Chordino engine (duration comes
# from a metadata probe instead). Chords are identical; tempo is null and key
# is "unknown". Default 1 (full analysis).
# CHORD_META=1

# S2 — beat snapping. SNAP_TO_BEATS=0 skips beat tracking entirely (no tempo
# either — fastest path, UI shows "—" for BPM). Default 1.
# SNAP_TO_BEATS=1

# S4 — template-engine chroma frontend (experimental profiling knobs).
# CHROMA_KIND=cqt (default) | cens | stft. cens is usually faster than
# cqt at similar quality; stft is cheapest with coarser pitch resolution.
# Validate any non-default against the chord eval harness before shipping.
# CHROMA_KIND=cqt
# CHROMA_HOP=2048
# CHROMA_NN_FILTER=1

# A2 — key-aware Viterbi (template engine only). KEY_AWARE=1 does a two-pass
# decode: estimate the global key from chroma, then bias transitions toward
# diatonic chords (fixes C<->Am / G<->Em flicker). Validate on the eval
# harness (A2.2) before enabling — default 0 until then.
# KEY_AWARE=0

# A4 — chord input. CHORD_SOURCE=mix (default) analyzes the upload as-is;
# =stem runs demucs first and analyzes the accompaniment (drums+bass+other),
# helping dense/distorted mixes at the cost of a separation run (cached per
# file). Engine tag gains a "+stem" suffix so eval rows stay comparable.
# Compare with: CHORD_SOURCE=stem --run chordino --tag chordino-stem (A4.2).
# CHORD_SOURCE=mix

# Lyrics pipeline (Phases 1–5). Every stage is flagged and falls back gracefully.
# WHISPER_MODEL is the default for auto/en. Hindi/Malayalam use Indic
# fine-tunes (adalat-ai medium, Apache-2.0) unless overridden; if an HF model
# fails to load, the pipeline falls back to large-v3-turbo automatically.
ENABLE_LYRICS=1
WHISPER_MODEL=small
# WHISPER_LANGUAGE=en            # hard override when upload has no language hint
# WHISPER_MODEL_OVERRIDES={"hi":"adalat-ai/whisper-small-hi-high-lr","ml":"large-v3-turbo"}
# auto → cuda when CTranslate2 sees a GPU and cuBLAS 12 loads, else cpu.
WHISPER_DEVICE=auto
# WHISPER_COMPUTE_TYPE=         # empty → int8_float16 on cuda, int8 on cpu
# A1: language ID runs on the vocal stem before model routing; detection is
# biased toward these (singing confuses Malayalam with Tamil).
# LYRICS_LANG_CANDIDATES=hi,ml,en
# LYRICS_LID_MODEL=small
# LYRICS_ASR_BATCH=8
# LYRICS_ASR_BEAM=5             # 1 ≈ 38% faster; accuracy impact unmeasured
# HF_TOKEN=                    # gated models (indic-transcribe-core for Malayalam);
#                               or run `hf auth login` once instead

# Phase 1 — vocal separation: none | demucs | roformer (default demucs).
# Demucs model: htdemucs (first run downloads weights). Roformer checkpoint
# resolves from audio-separator's installed model list when left empty.
LYRICS_SEPARATION_BACKEND=demucs
# Device for torch models (demucs separation, forced aligner): auto picks the
# CUDA GPU when torch can see one (GTX 1650 4 GB is enough), else CPU.
LYRICS_DEVICE=auto
# htdemucs (default) is ~4x cheaper than htdemucs_ft (a 4-model bag).
# LYRICS_DEMUCS_MODEL=htdemucs
# LYRICS_DEMUCS_OVERLAP=0.25   # 0.1 is ~15-20% faster on CPU, slightly rougher stems
# LYRICS_ROFORMER_MODEL=mel_band_roformer_vocals_becruily.ckpt
# LYRICS_DEREVERB=0            # experimental dereverb sub-stage (default off)
# LYRICS_DEREVERB_MODEL=
# LYRICS_SEPARATION_TIMEOUT_S=600

# Phase 2 — LRCLIB verified-lyrics lookup (free, no key). Disable to force ASR.
LYRICS_LRCLIB=1
# LYRICS_LRCLIB_TIMEOUT_S=10

# Phase 3 — music-tuned chunking (seconds). Indic scripts are token-dense:
# 10–15 s windows avoid the 448-token truncation of 30 s windows.
# LYRICS_ASR_CHUNK_S=12
# LYRICS_ASR_OVERLAP_S=2

# Phase 4 — CTC forced alignment (MMS weights are CC-BY-NC — see THIRD_PARTY_NOTICES.md).
LYRICS_ALIGNMENT=1
# LYRICS_ALIGN_INT8=0         # CPU only: int8 aligner, ~5x faster, timing shifts on ~1 in 6 words
# LYRICS_ALIGNMENT_MODEL=MahmoudAshraf/mms-300m-1130-forced-aligner

# Phase 5a — LLM cleanup (no provider wired; off by default, ASR text only).
LYRICS_LLM_CLEANUP=0

# Phase 5b — romanisation backend for the English-letter lyrics view:
# readable (default; everyday Hinglish/Manglish spelling, pipeline/romanise.py)
# | indic (Harvard-Kyoto) | xlit (blocked on fairseq/py3.11).
# LYRICS_ROMAN_BACKEND=readable

# Shared on-disk cache for every lyrics stage (content-hash keyed).
# LYRICS_CACHE_DIR=/tmp/chordex_lyrics_cache

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# Maximum upload size in megabytes
MAX_FILE_SIZE_MB=20

# YouTube links (POST /api/analyze-url): longest video accepted, seconds.
# YOUTUBE_MAX_DURATION_S=1200

# How long an analysis job may run (seconds). Must cover CPU separation + ASR
# and, the first time a language is used, a 0.5–1.5 GB model download. RQ
# SIGKILLs the work horse at job_timeout + 60 s, so keep this generous.
# JOB_TIMEOUT_S=7200

# S3 — timeout for the fast chord-only job (seconds). Chord recognition is
# ~5–60 s; anything past 10 min means a stuck plugin. Lyrics keep the long
# JOB_TIMEOUT_S above.
# CHORD_TIMEOUT_S=600

# S3 — job topology. Uploads always enqueue two jobs: chord_jobs (fast,
# renders in seconds) then lyrics_jobs (slow). One `python worker.py` serves
# both queues with chords prioritized; scale out with dedicated processes:
#   python worker.py lyrics_jobs   # lyrics-only (one per GPU/RAM budget)
#   python worker.py chord_jobs    # chords-only

# huggingface_hub transfer backend. hf-xet can stall on some networks
# (measured here: 17 KB written in 40 s with xet vs 20 MB in 40 s without), so
# the backend switches it off by default — see pipeline/hf_setup.py. Set to 0
# to opt back in after upgrading hf-xet.
# HF_HUB_DISABLE_XET=1

# Optional S3/R2 storage (leave empty for local filesystem)
# S3_BUCKET=
# S3_PREFIX=uploads
# S3_ENDPOINT_URL=
# AWS_REGION=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
