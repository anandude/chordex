# Backend environment variables
# Copy this to .env and fill in your values for local development.

# Redis connection string (rediss://... for Upstash TLS)
REDIS_URL=redis://localhost:6379

# Shared upload directory (API + worker must see the same path)
UPLOAD_DIR=/tmp/chordex_uploads

# Chord engine: auto | chordino | template
CHORD_ENGINE=auto

# Lyrics (faster-whisper). Set ENABLE_LYRICS=0 to skip.
ENABLE_LYRICS=1
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# Maximum upload size in megabytes
MAX_FILE_SIZE_MB=20

# Optional S3/R2 storage (leave empty for local filesystem)
# S3_BUCKET=
# S3_PREFIX=uploads
# S3_ENDPOINT_URL=
# AWS_REGION=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
