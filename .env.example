# Frontend environment (Next.js, at the repo root since the move in 97470d6).
# Copy to .env.local for local development.
#
# NEXT_PUBLIC_* is baked into the bundle at build time, so production builds
# must have it set in the build environment (Cloudflare Pages / Vercel), not
# only in .env.local. No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8000
