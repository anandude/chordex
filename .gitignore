# Runtime (start.sh)
.run/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
*.pyc

# Uploads / cache
/data/
backend/data/uploads/
**/s3_cache/

# Node / Next
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env.local
frontend/.env*.local
frontend/tsconfig.tsbuildinfo
# frontend moved to the repo root; ignore its build output there too
node_modules/
.next/
out/
.env*.local
tsconfig.tsbuildinfo

# IDE / OS
.idea/
.vscode/
.DS_Store
*.swp
.pytest_cache/
.coverage
htmlcov/

# Agent session / planning scratch (never commit — local-only context)
.commandcode/
.zcode/
# Bolt telemetry artifacts (`Added _events_7.json` style commits)
_events_*.json
.rscinfo

# Models / large binaries (if downloaded later)
backend/models/*.pt
backend/models/*.pth
backend/models/*.ckpt
!backend/models/.gitkeep

# Raw design downloads (not wired into the app)
/assets/
/public/graphics/
/public/logo/
backend/models/ct2/

# Audio is never committed (copyright). Put your own songs here locally.
test-assets/songs/*
!test-assets/songs/README.md
eval/songs/*
!eval/songs/.gitkeep
*.mp3
*.m4a
*.flac

# Licensed design assets must never be committed (fonts, icon packs,
# textures bought for personal use); the app uses open-licensed fonts/icons.
*.otf
*.ttf
*.woff
*.woff2

# Local notes / reports
moises-rea-report.md
